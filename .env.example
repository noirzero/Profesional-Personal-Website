# Email Configuration (optional for production)
SENDGRID_API_KEY=your_sendgrid_api_key_here
CONTACT_EMAIL=your-email@example.com
FROM_EMAIL=noreply@example.com

# Database (SQLite for local dev)
DATABASE_URL="file:./dev.db"

# NextAuth (for admin authentication)
GITHUB_ID=your_github_oauth_client_id
GITHUB_SECRET=your_github_oauth_client_secret
NEXTAUTH_SECRET=some_random_long_secret

# Dev-only fallback admin password (optional):
# Set this in local env to enable a simple Credentials-based admin sign-in
# for testing without OAuth. This provider is enabled only when ADMIN_PASSWORD
# is present and NODE_ENV !== 'production'. Do NOT set this in production.
ADMIN_PASSWORD=changeme

# Public site URL used for RSS and absolute links. Set this in production.
NEXT_PUBLIC_SITE_URL=https://yourname.com

# Google Analytics measurement id (optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Sentry (optional client DSN) - for client error reporting. For full server
# coverage consider adding `@sentry/nextjs` and server config.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_RATE=0.0

# Server-side Sentry (optional) - set this for server error/transaction capture
SENTRY_DSN=
SENTRY_TRACES_RATE=0.0
